{
  "name": "@kabawat/jwt-auth",
  "version": "0.0.1",
  "description": "Production-ready RS256 JWT creation and JWKS verification for distributed services",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kabawat/JWT-Auth.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./create": {
      "types": "./dist/create.d.ts",
      "import": "./dist/create.js",
      "default": "./dist/create.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js",
      "default": "./dist/verify.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/obfuscate-dist.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --test tests/**/*.test.js",
    "manual-test": "npm run build && node examples/manual-test.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "jwt",
    "jose",
    "jwks",
    "authentication",
    "rs256",
    "token",
    "kabawat"
  ],
  "author": "Kabawat",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "javascript-obfuscator": "^5.9.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
